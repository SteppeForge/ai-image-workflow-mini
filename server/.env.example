# Image generation provider:
#   pollinations (default) — real AI generation via https://pollinations.ai, no key required
#   mock                   — offline development and demos without network access
IMAGE_PROVIDER=pollinations

# Optional Pollinations token (free registration at https://enter.pollinations.ai):
#   - raises rate limits (anonymous tier: ~1 request / 15 s)
#   - enables real image editing (kontext model via gen.pollinations.ai)
# Never exposed to the frontend.
POLLINATIONS_API_KEY=

# Per-job provider call timeout, ms
IMAGE_TIMEOUT_MS=120000

# Server
PORT=3001
